{
  "name": "wordbound-crescendo",
  "private": true,
  "description": "Wordbound: Crescendo, a words-vs-music browser game. Built with Vite + React (`npm run dev` / `npm run build`); game logic stays framework-agnostic plain JS.",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "vite",
    "build": "vite build",
    "build:site": "bun tools/build-site.js",
    "deploy": "bash tools/deploy.sh",
    "preview": "vite preview",
    "build:itch": "bun tools/build-itch.js",
    "fetch:audio": "bun tools/fetch-audio.js",
    "fetch:words": "bun tools/fetch-wiktionary.js",
    "debug:run": "vite-node tools/debug-run.ts --",
    "debug:shop": "vite-node tools/debug-run.ts -- --fights=1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": "prettier --write"
  }
}
