{
  "name": "wordbound-crescendo",
  "private": true,
  "description": "Wordbound: Crescendo, a words-vs-music browser game engine-forked from Wordbound. Built with Vite + React (`npm run dev` / `npm run build`); game logic stays framework-agnostic plain JS.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "node tools/ensure-deps.js jsdom",
    "test": "node test/dom-check.js",
    "pretest:mobile": "node tools/ensure-deps.js @playwright/test",
    "test:mobile": "node test/verify-mobile-layout.js",
    "pretest:run-header": "node tools/ensure-deps.js @playwright/test",
    "test:run-header": "node test/verify-run-header-overflow.js",
    "pretest:qa": "node tools/ensure-deps.js @playwright/test",
    "test:qa": "node test/orchestrator-qa-boss-reward.js",
    "pretest:audio": "node tools/ensure-deps.js @playwright/test",
    "test:audio": "node test/verify-audio-context.js",
    "test:drag-interrupt": "node test/verify-drag-interrupt.js",
    "build:itch": "node tools/build-itch.js",
    "pretest:itch-build": "node tools/ensure-deps.js @playwright/test",
    "test:itch-build": "node test/verify-itch-build.js",
    "prerecord:gameplay": "node tools/ensure-deps.js @playwright/test",
    "record:gameplay": "node tools/record-gameplay.js",
    "pretest:branching-map": "node tools/ensure-deps.js jsdom",
    "test:branching-map": "node test/verify-branching-map.js",
    "pretest:react": "node tools/ensure-deps.js vitest @testing-library/react @testing-library/jest-dom @testing-library/user-event",
    "test:react": "vitest run",
    "pretest:react-build": "node tools/ensure-deps.js @playwright/test",
    "test:react-build": "node test/verify-react-build.js",
    "pretest:react-qa": "node tools/ensure-deps.js @playwright/test",
    "test:react-qa": "node test/verify-react-qa-boss-reward.js",
    "pretest:react-duel-loss": "node tools/ensure-deps.js @playwright/test",
    "test:react-duel-loss": "node test/verify-react-duel-loss.js",
    "pretest:music-engine": "node tools/ensure-deps.js @playwright/test",
    "test:music-engine": "node test/verify-music-engine.js",
    "test:duel-balance": "node test/duel-balance-simulation.js",
    "pretest:regular-duel-smoke": "node tools/ensure-deps.js @playwright/test",
    "test:regular-duel-smoke": "node test/verify-regular-duel-smoke.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^25.0.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
