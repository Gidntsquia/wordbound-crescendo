{
  "name": "wordbound-crescendo",
  "private": true,
  "description": "Wordbound: Crescendo, a words-vs-music browser game engine-forked from Wordbound. Built with Vite + React (`npm run dev` / `npm run build`); game logic stays framework-agnostic plain JS.",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "vite --open /sandbox.html",
    "build": "vite build",
    "build:site": "node tools/build-site.js",
    "deploy": "bash tools/deploy.sh",
    "preview": "vite preview",
    "build:itch": "node tools/build-itch.js",
    "prerecord:gameplay": "node tools/ensure-deps.js @playwright/test",
    "record:gameplay": "node tools/record-gameplay.js",
    "fetch:audio": "node tools/fetch-audio.js"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2"
  }
}
